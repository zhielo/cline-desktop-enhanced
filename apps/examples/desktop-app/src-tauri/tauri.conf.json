{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cline Enhanced",
	"version": "0.0.34",
	"identifier": "app.zhielo.cline-enhanced",
	"build": {
		"beforeDevCommand": "bun run build:sidecar:bin && bun run dev:web",
		"devUrl": "http://localhost:3125",
		"beforeBuildCommand": "bun run dmg:background && bun run build",
		"frontendDist": "../webview/out"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Cline Enhanced",
				"width": 1500,
				"height": 980,
				"resizable": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": ["bin/code-sidecar"],
		"resources": [
			"icons/app/*.png",
			"icons/app/macos/*.png",
			"bin/remote-helpers/*"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"compression": "zlib",
				"installMode": "currentUser"
			},
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			}
		},
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"dmg": {
				"background": "dmg/background.gen.tiff",
				"windowSize": {
					"width": 640,
					"height": 432
				},
				"appPosition": {
					"x": 140,
					"y": 200
				},
				"applicationFolderPosition": {
					"x": 500,
					"y": 200
				}
			}
		}
	}
}
